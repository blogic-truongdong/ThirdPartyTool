<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
	</configSections>

	<log4net>
		<appender name="BLogicLog" type="log4net.Appender.RollingFileAppender">
			<file value="Logs/" />
			<appendToFile value="true" />
			<countDirection value="-1"/>
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd'.txt'" />
			<maximumFileSize value="200KB" />
			<maxSizeRollBackups value="99" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%t] %-5p %c - %m%n" />
			</layout>
		</appender>

		<!-- levels: DEBUG, INFO, WARN, ERROR, FATAL -->
		<root>
			<level value="DEBUG" />
			<appender-ref ref="BLogicLog" />
		</root>

		<!--<logger name="SyncDataSevenShiftsLogger" additivity="false">
			<level value="DEBUG" />
			<appender-ref ref="SyncDataSevenShiftsLog" />
		</logger>-->
	</log4net>
	
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>